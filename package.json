{
  "name": "rscalc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OSRS shop -> Grand Exchange profit calculator",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "shops": "tsx scripts/refresh-shops.ts",
    "market": "tsx scripts/refresh-market.ts",
    "report": "tsx scripts/report.ts",
    "sinks": "tsx scripts/refresh-sinks.ts",
    "build:data": "pnpm shops && pnpm market",
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
