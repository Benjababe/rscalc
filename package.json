{
  "name": "rscalc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OSRS gp-per-hour calculator: shop runs, GE flips and processing",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "shops": "tsx scripts/refresh-shops.ts",
    "market": "tsx scripts/refresh-market.ts",
    "report": "tsx scripts/report.ts",
    "sinks": "tsx scripts/refresh-sinks.ts",
    "process": "tsx scripts/refresh-process.ts",
    "skilling": "tsx scripts/refresh-skilling.ts",
    "access": "tsx scripts/refresh-access.ts",
    "build:data": "pnpm shops && pnpm market",
    "refresh": "pnpm shops && pnpm run access && pnpm market && pnpm report --write && pnpm sinks --write && pnpm process && pnpm skilling",
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
